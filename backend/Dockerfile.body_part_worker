# Body Part QC worker container.
#
# Runs the heavy compute (encoder inference, training, embedding extraction)
# for the cohort-wide Body Part QC module. Backend talks to it over HTTP at
# `http://body-part-qc-worker:8000/...`.
#
# GPU usage is automatic: if the host has the NVIDIA Container Toolkit and
# this service is started with `--gpus all` (e.g. via
# `docker-compose.override.gpu.yml`), torch.cuda.is_available() is True at
# runtime and encoders run on CUDA. Otherwise everything falls back to CPU.

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf_cache

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git ca-certificates \
        libopenjp2-7 libgl1 \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-friendly torch wheels are fine — the same image works on CPU-only
# hosts; CUDA libs are loaded only when --gpus is passed at runtime.
RUN pip install --upgrade pip && \
    # Pin PyTorch to a CUDA-12.1 build so it stays compatible with the
    # baseline NVIDIA driver shipping CUDA-12.x runtime support.
    # Newer PyTorch (>=2.6) defaults to CUDA-13 wheels which require
    # driver >=565 and would silently fall back to CPU on common hosts.
    pip install --extra-index-url https://download.pytorch.org/whl/cu121 \
        "torch==2.5.1+cu121" "torchvision==0.20.1+cu121" && \
    pip install \
        "open_clip_torch>=2.24" \
        "transformers>=4.41" \
        "pydicom>=2.4" "pylibjpeg>=2.0" "pylibjpeg-libjpeg>=2.1" \
        "numpy>=1.26,<2" "pillow>=10.0" \
        "scikit-learn>=1.4" "joblib>=1.3" \
        "fastapi>=0.110" "uvicorn[standard]>=0.27" \
        "pyyaml>=6.0" \
        "psycopg[binary]>=3.1" "sqlalchemy>=2.0" \
        "python-dateutil>=2.9" \
        "pydantic>=2.10"

# Pre-bake encoder weights so the runtime never downloads them.
# This makes the image larger but startup is instant and deterministic.
RUN python - <<'PY'
import os
os.makedirs("/opt/hf_cache", exist_ok=True)
import open_clip  # noqa: F401
# BiomedCLIP — image + text tower
open_clip.create_model_and_transforms(
    "hf-hub:microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224"
)
# SigLIP2 — image only
import transformers
transformers.AutoModel.from_pretrained("google/siglip2-base-patch16-224")
transformers.AutoProcessor.from_pretrained("google/siglip2-base-patch16-224")
print("Encoder weights pre-baked into image.")
PY

COPY src /app/src
ENV PYTHONPATH=/app/src

EXPOSE 8000
CMD ["uvicorn", "qc.body_part.server:app", "--host", "0.0.0.0", "--port", "8000"]
